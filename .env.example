# Copy to .env and fill in real values. Never commit .env.
DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me
# At least 32 random characters, e.g. from: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# true only when the app is served over HTTPS
COOKIE_SECURE=false

# First start only: the owner account created when there are no users yet.
# Log in, change the password, then you may remove these lines.
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me-on-first-login
OWNER_FULL_NAME=Owner

# Receipts and tax (not secrets; shown on every receipt)
VAT_RATE_PERCENT=16
SHOP_PHONE=07XX XXX XXX
SHOP_KRA_PIN=P000000000X
SHOP_TILL_NUMBER=000000
SHOP_PAYBILL_NUMBER=000000
SHOP_PAYBILL_ACCOUNT=TAVUZI
# Network receipt printer (leave empty to print from the browser)
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_WIDTH=48

# SMS receipts and promotions (Africa's Talking). Leave AT_API_KEY empty to only log SMS.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true
SMS_PROMO_FOOTER=Reply STOP to opt out.

# M-Pesa Daraja (used from milestone 4)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
